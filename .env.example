# =============================================================
# 1) WEB / SOCIAL-MEDIA SEARCH (optional but recommended)
# =============================================================
# Free key from https://serper.dev/ (Google Lens reverse-image search).
# The face crop is uploaded to a temporary public host and searched.
# If this is left empty, the pipeline falls back to an interactive
# manual search step (you paste the URL of a real matching post).
SERPER_API_KEY=

# =============================================================
# 2) BLOCKCHAIN — Ethereum Sepolia testnet (optional)
# =============================================================
# If ALL THREE values below are set, discovered post data is anchored
# to the real Sepolia testnet and re-verified against the on-chain
# record. If ANY value is missing, the pipeline automatically uses the
# built-in LOCAL SIMULATED CHAIN (.local_chain.json) instead, so the
# demo always runs end to end.
#
# Sepolia RPC endpoint from Alchemy, Infura, etc.
SEPOLIA_RPC_URL=
# Test wallet private key. Never use a wallet holding real funds.
PRIVATE_KEY=
# Fill this after running: python deploy_contract.py
CONTRACT_ADDRESS=